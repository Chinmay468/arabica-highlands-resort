# Database connection with SQLite WAL mode and busy timeout
DATABASE_URL="file:./dev.db?connection_limit=1&journal_mode=WAL&busy_timeout=5000"

# Node Environment
NODE_ENV="development"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional LLM API Key (System automatically falls back to deterministic local AI engine if unset)
GEMINI_API_KEY=""
